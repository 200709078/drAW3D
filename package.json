{
  "name": "draw3d",
  "productName": "drAW3D",
  "desktopName": "draw3d",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "drAW3D — 3B geometri ve açınım uygulaması",
  "author": "mADEMatik <madematik@madematik.com>",
  "license": "MIT",
  "homepage": "https://www.madematik.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/200709078/drAW3D.git"
  },
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.electron.json --noEmit",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run typecheck && npm run build:electron && vite build",
    "deploy": "npm run build && node scripts/deploy-ftp.mjs",
    "preview": "vite preview",
    "electron:dev": "npm run build:electron && node scripts/dev-electron.mjs",
    "electron": "npm run build && node scripts/start-electron.mjs",
    "test": "playwright test",
    "test:electron": "npm run build && node scripts/test-electron.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleRelease",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "mathjs": "15.2.0",
    "three": "0.184.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/three": "^0.184.0",
    "basic-ftp": "^6.2.3",
    "dotenv": "^17.4.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.4"
  },
  "build": {
    "appId": "com.madematik.draw3d",
    "productName": "drAW3D",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "artifactName": "${productName}-${os}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icons",
      "category": "Education;Math",
      "executableName": "draw3d",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Name": "drAW3D",
          "Comment": "3B geometri ve açınım"
        }
      }
    },
    "deb": {
      "packageCategory": "education"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "drAW3D"
    }
  }
}
